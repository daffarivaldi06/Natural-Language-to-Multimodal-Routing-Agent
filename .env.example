# Environment Variables — Natural Language to Multimodal Routing Agent
# Copy this file to .env and fill in your values

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://routing_user:secret@localhost:5432/routing_db

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1h

# ─── Google Gemini (Free tier) ───────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
# Free tier: 1,500 req/day, 15 RPM for gemini-2.0-flash-lite
GOOGLE_API_KEY=AIza...

# ─── App ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Optional: Real API keys (mocks used when not set) ──────────────────────
# ORS_API_KEY=your_openrouteservice_key
# NEXTBIKE_API_KEY=your_nextbike_key
